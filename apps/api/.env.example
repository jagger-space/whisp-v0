# Server only. Copy to apps/api/.env for local development.
# Required; set preview or production explicitly in the corresponding deployment.
# NODE_ENV controls runtime optimizations, not the data environment.
WHISP_ENV=development
PORT=3000

# These gates validate credentials; feature implementations arrive in later tickets.
# No database connection or session signing is performed by the health endpoint.
ENABLE_DATABASE=false
# When enabled, supply credentials restricted to this environment's database.
# MONGODB_URI=mongodb://replace-user:replace-password@localhost:27017/whisp_development

ENABLE_SESSION_SIGNING=false
# When enabled, replace with independently generated server-only signing material.
# SESSION_SIGNING_SECRET=replace-with-server-only-signing-material

# Provider credentials belong only on the API/deployment host when integrated.
# Never prefix a database, signing or provider credential with EXPO_PUBLIC_.
